{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "telescoop-kalender",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "d1_databases": [
    { "binding": "DB", "database_name": "telescoop-kalender" }
  ]
}
